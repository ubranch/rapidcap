<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same identifier as the GPUI build it replaces: TCC keeps the Screen
	     Recording grant against it and the signing certificate. -->
	<key>CFBundleIdentifier</key>
	<string>com.inspire.rapidcap</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>uz</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>RapidCap</string>
	<key>CFBundleName</key>
	<string>RapidCap</string>
	<key>CFBundleDisplayName</key>
	<string>RapidCap</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>rapidcap</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.1</string>
	<key>CFBundleVersion</key>
	<string>0.2.1</string>
	<!-- Liquid Glass: glassEffect and NSGlassEffectView are macOS 26 API. -->
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>RapidCap records your microphone into a video when you pick one in the audio menu.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
